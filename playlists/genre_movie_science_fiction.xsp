<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<smartplaylist type="movies">
    <name>Science Fiction</name>
    <match>all</match>
    <rule field="genre" operator="is">
        <value>Science Fiction</value>
        <value>Sci-Fi</value>
    </rule>
    <order direction="descending">dateadded</order>
</smartplaylist>
