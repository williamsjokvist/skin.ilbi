<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<smartplaylist type="movies">
    <name>Music</name>
    <match>all</match>
    <rule field="genre" operator="is">
        <value>Music</value>
        <value>Musical</value>
    </rule>
    <order direction="descending">dateadded</order>
</smartplaylist>
