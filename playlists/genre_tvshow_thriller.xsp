<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<smartplaylist type="tvshows">
    <name>Thriller</name>
    <match>all</match>
    <rule field="genre" operator="is">
        <value>Thriller</value>
        <value>Suspense</value>
    </rule>
    <order direction="descending">dateadded</order>
</smartplaylist>
