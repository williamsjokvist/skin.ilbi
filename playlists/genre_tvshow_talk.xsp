<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<smartplaylist type="tvshows">
    <name>Talk</name>
    <match>all</match>
    <rule field="genre" operator="is">
        <value>Talk</value>
        <value>Talk Show</value>
    </rule>
    <order direction="descending">dateadded</order>
</smartplaylist>
