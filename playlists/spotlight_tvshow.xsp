<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<smartplaylist type="tvshows">
    <name>Spotlight TV show</name>
    <match>all</match>
    <rule field="numepisodes" operator="greaterthan">
        <value>0</value>
    </rule>
    <limit>1</limit>
    <order direction="descending">random</order>
</smartplaylist>
