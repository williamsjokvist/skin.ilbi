<?xml version="1.0" encoding="UTF-8"?>
<includes>
	<!-- Episodes of one season: the strip and the stream badges. Backdrop and header come from
	     TVShowScreen. The only view offered for a real season's episodes; the listing
	     Kodi flattens a single-season series onto shares its node with View_58_Info -->
	<include name="View_57_Episodes">
		<control type="group">
			<centertop>50%</centertop>
			<height>1080</height>
			<centerleft>50%</centerleft>
			<width>1920</width>
			<visible>Control.IsVisible(57)</visible>
			<animation effect="fade" time="200">VisibleChange</animation>
			<include>OpenClose_Left</include>
			<control type="grouplist">
				<description>stream badges for the focused episode, opposite the clearlogo</description>
				<visible>!Skin.HasSetting(hide_mediaflags)</visible>
				<right>88</right>
				<top>84</top>
				<width>900</width>
				<height>44</height>
				<orientation>horizontal</orientation>
				<align>right</align>
				<itemgap>10</itemgap>
				<include content="InfoBadge">
					<param name="label" value="$VAR[InfoDialogResolutionBadgeVar]"/>
					<param name="visible" value="!String.IsEmpty(ListItem.VideoResolution)"/>
				</include>
				<include content="InfoBadge">
					<param name="label" value="$VAR[InfoDialogHdrBadgeVar]"/>
					<param name="visible" value="!String.IsEmpty(ListItem.HdrType)"/>
				</include>
				<include content="InfoBadge">
					<param name="label" value="$VAR[InfoDialogVideoCodecBadgeVar]"/>
					<param name="visible" value="!String.IsEmpty(ListItem.VideoCodec)"/>
				</include>
				<include content="InfoBadge">
					<param name="label" value="$VAR[InfoDialogAudioCodecBadgeVar]"/>
					<param name="visible" value="!String.IsEmpty(ListItem.AudioCodec)"/>
				</include>
				<include content="InfoBadge">
					<param name="label" value="$VAR[InfoDialogAudioChannelsBadgeVar]"/>
					<param name="visible" value="!String.IsEmpty(ListItem.AudioChannels)"/>
				</include>
			</control>
			<control type="panel" id="57">
				<description>one row of episode stills - the panel wraps, but only one row fits its
				     height. A single-season series is flattened straight past the seasons screen, so
				     back has no parent listing to step to - it goes to the series information
				     screen instead, which shares this node as another view of it. Every other
				     episode list has a seasons screen above it, and falls through to Kodi's own
				     parent-folder step</description>
				<left>60</left>
				<top>674</top>
				<width>1816</width>
				<height>380</height>
				<orientation>horizontal</orientation>
				<scrolltime tween="sine" easing="out">300</scrolltime>
				<preloaditems>2</preloaditems>
				<onup>9000</onup>
				<ondown>noop</ondown>
				<onleft>57</onleft>
				<onright>57</onright>
				<onback condition="$EXP[tvshow_flattened_episodes]">5710</onback>
				<!-- see View_56_Seasons: the tile covers the keys onback cannot. Only for a flattened
				     series, where this listing is the series' own node and the information screen is
				     another view of it. A real season's episodes have a seasons screen above them, and
				     Kodi's parent-folder step is already right there -->
				<onclick condition="ListItem.IsParentFolder + $EXP[tvshow_flattened_episodes]">Container.SetViewMode(58)</onclick>
				<onclick condition="ListItem.IsParentFolder + $EXP[tvshow_flattened_episodes]">SetFocus(5800)</onclick>
				<viewtype label="20360">icon</viewtype>
				<visible>Container.Content(episodes)</visible>
				<itemlayout width="456" height="318">
					<control type="group">
						<left>28</left>
						<top>28</top>
						<include content="TVShowScreenBackTile">
							<param name="top" value="74"/>
						</include>
					</control>
					<control type="group">
						<left>28</left>
						<top>28</top>
						<include>TVShowEpisodeCard</include>
					</control>
				</itemlayout>
				<focusedlayout width="456" height="318">
					<control type="group">
						<description>see View_56_Seasons: the back tile does not zoom with the cards</description>
						<left>28</left>
						<top>28</top>
						<include content="TVShowScreenBackTile">
							<param name="top" value="74"/>
							<param name="focused" value="true"/>
						</include>
					</control>
					<control type="group">
						<left>28</left>
						<top>28</top>
						<depth>DepthContentPopout</depth>
						<animation effect="zoom" start="100" end="110" time="200" tween="sine" easing="inout" center="210,118">Focus</animation>
						<animation effect="zoom" start="110" end="100" time="200" tween="sine" easing="inout" center="210,118">UnFocus</animation>
						<include content="TVShowEpisodeCard">
							<param name="focused" value="true"/>
						</include>
					</control>
				</focusedlayout>
			</control>
			<include content="TVShowScreenBackToInfo">
				<param name="id" value="5710"/>
			</include>
			<include content="LeftRightArrows">
				<param name="list_id" value="57"/>
				<param name="left_posx" value="40"/>
				<param name="right_posx" value="1852"/>
				<param name="posy" value="806"/>
			</include>
		</control>
	</include>
</includes>
