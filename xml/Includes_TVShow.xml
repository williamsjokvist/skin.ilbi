<?xml version="1.0" encoding="UTF-8"?>
<includes>
	<!-- The seasons and episodes screens. Both show one series dressed like the information
	     screen - full bleed fanart, left scrim, clearlogo over a meta line and the plot - with the
	     children of the thing being browsed as a strip along the bottom.

	     They are views on MyVideoNav rather than windows of their own: only a control listed in
	     that window's <views> is bound to the directory Kodi is browsing, so a window of our own
	     would have nothing to fill. Views 56 and 57 are the only ones offered for seasons and
	     episodes, so browsing into a series always lands here. -->
	<!-- The text block, identical in both screens and in the information dialog, which emits the
	     same include: the series names the page, the focused card names itself underneath. No logo
	     fadetime - the logo is the series', so it holds still across the two screens.

	     The plot is not part of the shared include (the dialog flows it into a grouplist with the
	     pills below it), so its geometry is repeated here and has to stay matched to the dialog's:
	     left 88, top 400, four lines of font27 wide 884 -->
	<include name="TVShowScreenHeader">
		<include content="InfoScreenHeader">
			<param name="logo" value="$VAR[TVShowScreenLogoVar]"/>
			<param name="has_logo" value="!String.IsEmpty(Container.Art(tvshow.clearlogo)) | !String.IsEmpty(ListItem.Art(tvshow.clearlogo)) | !String.IsEmpty(ListItem.Art(clearlogo))"/>
			<param name="title" value="$VAR[TVShowScreenTitleVar]"/>
			<param name="sublabel" value="$VAR[InfoDialogSubLabelVar]"/>
			<param name="meta" value="$VAR[InfoScreenMetaVar]"/>
			<param name="visible" value="!ListItem.IsParentFolder"/>
			<param name="sublabel_visible" value="!ListItem.IsParentFolder + !Control.IsVisible(58)"/>
		</include>
		<control type="textbox">
			<description>plot: four lines, fixed - anything longer would run into the strip below. Only
			     for the two strip screens: the information view draws its own inside the grouplist it
			     shares with the pills, so a short plot pulls them up the way the dialog's does</description>
			<left>88</left>
			<top>400</top>
			<width>884</width>
			<height>144</height>
			<font>font27</font>
			<label fallback="19055">$VAR[TVShowScreenPlotVar]</label>
			<shadowcolor>text_shadow</shadowcolor>
			<visible>!ListItem.IsParentFolder + !Control.IsVisible(58)</visible>
			<autoscroll delay="10000" time="5000" repeat="10000">Skin.HasSetting(AutoScroll)</autoscroll>
		</control>
	</include>
	<!-- The page frame. Emitted once for the whole series flow - the information dialog over a
	     series, its seasons, its episodes - so none of the steps between them changes its
	     visibility. Stepping from seasons into episodes swaps only the strip, and browsing out of
	     the dialog swaps only the container: the backdrop and the logo are these controls, already
	     standing, and they are never asked to appear or disappear on the way.

	     So nothing here animates on anything a step between those screens can trigger. VisibleChange
	     covers entering the flow from a poster wall and leaving it again; WindowOpen and WindowClose
	     cover arriving in the window and leaving it, and are the animation the information dialog
	     plays on open - the backdrop fading while the block over it slides in from the left, or just
	     fading when slide animations are off. A view swap fires neither, which is what keeps the
	     fanart and the logo still - see $EXP[tvshow_screen_visible] -->
	<include name="TVShowScreen">
		<definition>
			<control type="group">
				<description>backdrop. No fadetime on the image: the fanart is the series', not the
				     focused card's, and the variable behind it resolves to the same texture off a
				     focused series in a list as it does off a seasons or episodes container - so the
				     container swap does not even restate the path, let alone cross-fade it</description>
				<visible>$EXP[tvshow_screen_visible]</visible>
				<animation effect="fade" time="200">VisibleChange</animation>
				<animation effect="fade" start="0" end="100" time="300">WindowOpen</animation>
				<animation effect="fade" start="100" end="0" time="200">WindowClose</animation>
				<include content="InfoScreenBackdrop">
					<param name="fanart" value="$VAR[TVShowScreenFanartVar]"/>
				</include>
			</control>
			<control type="group">
				<description>header. Slides in with the window where the backdrop only fades, which is
				     the split the information dialog makes too - a full bleed backdrop slid 320px
				     would show its own edge, and the block of text is the part worth moving</description>
				<centertop>50%</centertop>
				<height>1080</height>
				<centerleft>50%</centerleft>
				<width>1920</width>
				<visible>$EXP[tvshow_screen_visible]</visible>
				<animation effect="fade" time="200">VisibleChange</animation>
				<include>OpenClose_Left</include>
				<include>TVShowScreenHeader</include>
			</control>
		</definition>
	</include>
	<!-- Back off a strip screen, onto the series information screen. It has to be a control rather
	     than a builtin: MyVideoNav is a media window, and the only <onback> that demonstrably fires
	     in one - here and in Estuary - names a control id. Pointing onback at a builtin on a view
	     container did nothing at all; back stayed with the window, which turns it into a
	     parent-folder step, and since the series node is the window's start directory that step
	     leaves for Home.

	     So back moves focus here instead, and arriving is what swaps the view. One pixel, no
	     texture, and it lives inside the strip's own group, so the moment the swap happens this is
	     not on screen to be focused again - which is also
	     why it has to hand the focus on itself, the same way the pills do swapping the other way -->
	<include name="TVShowScreenBackToInfo">
		<definition>
			<control type="button" id="$PARAM[id]">
				<left>0</left>
				<top>0</top>
				<width>1</width>
				<height>1</height>
				<onfocus>Container.SetViewMode(58)</onfocus>
				<onfocus>SetFocus(5800)</onfocus>
				<texturefocus/>
				<texturenofocus/>
			</control>
		</definition>
	</include>
	<!-- season card: poster over the season name and its watched tally -->
	<include name="TVShowSeasonCard">
		<param name="focused">false</param>
		<definition>
			<control type="group">
				<left>0</left>
				<top>0</top>
				<width>200</width>
				<height>372</height>
				<description>hidden for the parent item Kodi inserts - that slot gets the back tile
				     the layout places instead</description>
				<visible>!ListItem.IsParentFolder</visible>
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>200</width>
					<height>300</height>
					<aspectratio align="center" aligny="center">scale</aspectratio>
					<texture background="true" fallback="DefaultVideo.png">$VAR[SeasonCardArtVar]</texture>
				</control>
				<control type="image">
					<description>rounds the corners against the scrim</description>
					<left>0</left>
					<top>0</top>
					<width>200</width>
					<height>300</height>
					<texture border="24">poster_mask.png</texture>
					<visible>!Skin.HasSetting(no_poster_radius)</visible>
				</control>
				<control type="image">
					<description>tick, only once every episode in the season has been watched</description>
					<left>148</left>
					<top>12</top>
					<width>36</width>
					<height>36</height>
					<texture>OverlayWatched.png</texture>
					<visible>!String.IsEmpty(ListItem.Property(TotalEpisodes)) + String.IsEqual(ListItem.Property(WatchedEpisodes),ListItem.Property(TotalEpisodes))</visible>
				</control>
				<control type="label">
					<left>0</left>
					<top>310</top>
					<width>200</width>
					<height>32</height>
					<align>center</align>
					<aligny>center</aligny>
					<font>font12</font>
					<scroll>$PARAM[focused]</scroll>
					<label>$INFO[ListItem.Label]</label>
					<shadowcolor>text_shadow</shadowcolor>
				</control>
				<control type="label">
					<left>0</left>
					<top>342</top>
					<width>200</width>
					<height>30</height>
					<align>center</align>
					<aligny>center</aligny>
					<font>font12</font>
					<textcolor>grey</textcolor>
					<label>$VAR[WatchedStatusVar]</label>
					<shadowcolor>text_shadow</shadowcolor>
				</control>
			</control>
		</definition>
	</include>
	<!-- Kodi inserts a parent item into any listing that is not the directory the window was
	     opened at. Style it as the information screen's icon buttons: same 64px pill, same dim
	     fill, same inversion to a white pill with a dark glyph on focus. It cannot be an
	     InfoIconButton, because an item layout only takes image, label and group controls - no
	     focusable ones - so both of that button's states are drawn out here instead.

	     Placed at the same screen position on both strips, which have different card sizes and
	     sit at different heights: each passes the top that lands this at 776, and left 0 puts it
	     on the same 88 as the clearlogo and the text block above -->
	<include name="TVShowScreenBackTile">
		<param name="focused">false</param>
		<definition>
			<control type="group">
				<left>0</left>
				<top>$PARAM[top]</top>
				<width>64</width>
				<height>64</height>
				<visible>ListItem.IsParentFolder</visible>
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>64</width>
					<height>64</height>
					<texture border="31" colordiffuse="33FFFFFF">pill.png</texture>
					<visible>!$PARAM[focused]</visible>
				</control>
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>64</width>
					<height>64</height>
					<texture border="31">pill.png</texture>
					<visible>$PARAM[focused]</visible>
				</control>
				<control type="image">
					<left>16</left>
					<top>16</top>
					<width>32</width>
					<height>32</height>
					<aspectratio>keep</aspectratio>
					<texture flipx="true" colordiffuse="white">overlays/arrowright.png</texture>
					<visible>!$PARAM[focused]</visible>
				</control>
				<control type="image">
					<left>16</left>
					<top>16</top>
					<width>32</width>
					<height>32</height>
					<aspectratio>keep</aspectratio>
					<texture flipx="true" colordiffuse="FF181818">overlays/arrowright.png</texture>
					<visible>$PARAM[focused]</visible>
				</control>
			</control>
		</definition>
	</include>
	<!-- episode card: the still, its resume position, then the number and title -->
	<include name="TVShowEpisodeCard">
		<param name="focused">false</param>
		<definition>
			<control type="group">
				<left>0</left>
				<top>0</top>
				<width>420</width>
				<height>318</height>
				<description>hidden for the parent item Kodi inserts - that slot gets the back tile
				     the layout places instead</description>
				<visible>!ListItem.IsParentFolder</visible>
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>420</width>
					<height>236</height>
					<aspectratio align="center" aligny="center">scale</aspectratio>
					<texture background="true" fallback="DefaultVideo.png">$VAR[EpisodeCardArtVar]</texture>
				</control>
				<control type="progress">
					<left>0</left>
					<top>228</top>
					<width>420</width>
					<height>6</height>
					<texturebg border="3" colordiffuse="40FFFFFF">progress/texturebg_alt_white.png</texturebg>
					<midtexture border="3" colordiffuse="button_focus">progress/texturebg_alt_white.png</midtexture>
					<info>ListItem.PercentPlayed</info>
					<visible>!Integer.IsEqual(ListItem.PercentPlayed,0)</visible>
				</control>
				<control type="image">
					<description>rounds the corners against the scrim</description>
					<left>0</left>
					<top>0</top>
					<width>420</width>
					<height>236</height>
					<texture border="24">poster_mask.png</texture>
					<visible>!Skin.HasSetting(no_poster_radius)</visible>
				</control>
				<control type="image">
					<left>372</left>
					<top>12</top>
					<width>36</width>
					<height>36</height>
					<texture>$VAR[ItemStatusIconVar]</texture>
				</control>
				<control type="label">
					<left>4</left>
					<top>246</top>
					<width>412</width>
					<height>32</height>
					<aligny>center</aligny>
					<font>font12</font>
					<scroll>$PARAM[focused]</scroll>
					<label>$INFO[ListItem.Episode,,.  ]$INFO[ListItem.Title]</label>
					<shadowcolor>text_shadow</shadowcolor>
				</control>
				<control type="label">
					<left>4</left>
					<top>278</top>
					<width>412</width>
					<height>30</height>
					<aligny>center</aligny>
					<font>font12</font>
					<textcolor>grey</textcolor>
					<label>$VAR[EpisodeCardSubLabelVar]</label>
					<shadowcolor>text_shadow</shadowcolor>
				</control>
			</control>
		</definition>
	</include>
</includes>
