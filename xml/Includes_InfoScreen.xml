<?xml version="1.0" encoding="UTF-8"?>
<includes>
	<include name="InfoScreenBackdrop">
		<definition>
			<control type="group">
				<include>FullScreenDimensions</include>
				<control type="image">
					<description>opaque backing</description>
					<include>FullScreenDimensions</include>
					<texture>colors/black.png</texture>
				</control>
				<control type="image">
					<description>fanart, full bleed on every aspect</description>
					<include>FullScreenDimensions</include>
					<aspectratio>scale</aspectratio>
					<texture background="true" fallback="DefaultVideo.png">$PARAM[fanart]</texture>
				</control>
				<control type="image">
					<description>flat dim over the whole frame</description>
					<include>FullScreenDimensions</include>
					<texture colordiffuse="4DFFFFFF">colors/black.png</texture>
				</control>
				<control type="image">
					<description>left scrim, under the text block</description>
					<include>FullScreenDimensions</include>
					<texture>scrim_left.png</texture>
				</control>
				<control type="image">
					<description>bottom scrim, under the pills or the card strip</description>
					<left>0</left>
					<bottom>0</bottom>
					<width>100%</width>
					<height>460</height>
					<texture colordiffuse="DD000000">overlays/overlayfade.png</texture>
				</control>
			</control>
		</definition>
	</include>
	<include name="InfoScreenHeader">
		<param name="logo_fadetime">0</param>
		<param name="visible">true</param>
		<param name="sublabel_visible">true</param>
		<definition>
			<control type="image">
				<description>clearlogo, bottom aligned so short and tall logos share a baseline</description>
				<left>88</left>
				<top>60</top>
				<width>620</width>
				<height>190</height>
				<aspectratio align="left" aligny="bottom">keep</aspectratio>
				<fadetime>$PARAM[logo_fadetime]</fadetime>
				<texture>$PARAM[logo]</texture>
				<visible>$PARAM[has_logo]</visible>
			</control>
			<control type="label">
				<description>title, the fallback when there is no clearlogo</description>
				<left>92</left>
				<top>60</top>
				<width>1180</width>
				<height>190</height>
				<aligny>bottom</aligny>
				<font>font52_title</font>
				<label>$PARAM[title]</label>
				<scroll>true</scroll>
				<shadowcolor>text_shadow</shadowcolor>
				<visible>![$PARAM[has_logo]]</visible>
			</control>
			<control type="label">
				<description>the season, the episode number and title, or the movie tagline</description>
				<left>92</left>
				<top>274</top>
				<width>1180</width>
				<height>38</height>
				<font>font27_title</font>
				<textcolor>grey</textcolor>
				<label>$PARAM[sublabel]</label>
				<shadowcolor>text_shadow</shadowcolor>
				<visible>$PARAM[sublabel_visible]</visible>
			</control>
			<control type="label">
				<description>one meta line</description>
				<left>92</left>
				<top>336</top>
				<width>1400</width>
				<height>46</height>
				<aligny>center</aligny>
				<font>font27_title</font>
				<label>$PARAM[meta]</label>
				<shadowcolor>text_shadow</shadowcolor>
				<visible>$PARAM[visible]</visible>
			</control>
		</definition>
	</include>
</includes>
