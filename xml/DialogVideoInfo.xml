<?xml version="1.0" encoding="UTF-8"?>
<window>
	<defaultcontrol always="true">8</defaultcontrol>
	<onload>SetProperty(infobackground,$ESCINFO[ListItem.Art(fanart)],home)</onload>
	<onunload>ClearProperty(infobackground,home)</onunload>
	<controls>
		<control type="group">
			<description>backdrop: the item's fanart, full bleed on every aspect, scrimmed for the text block</description>
			<include>FullScreenDimensions</include>
			<animation effect="fade" start="0" end="100" time="300">WindowOpen</animation>
			<animation effect="fade" start="100" end="0" time="200">WindowClose</animation>
			<animation effect="fade" start="100" end="0" time="200" tween="sine" condition="Window.IsVisible(script-embuary-video.xml) | Window.IsVisible(script-embuary-person.xml) | Window.IsVisible(script-embuary-image.xml)">Conditional</animation>
			<control type="image">
				<description>opaque backing: the dialog covers the window under it, so nothing shows through the cross-fade</description>
				<include>FullScreenDimensions</include>
				<texture>colors/black.png</texture>
			</control>
			<control type="image">
				<include>FullScreenDimensions</include>
				<aspectratio>scale</aspectratio>
				<fadetime>300</fadetime>
				<texture background="true" fallback="DefaultVideo.png">$VAR[InfoDialogFanartVar]</texture>
			</control>
			<control type="image">
				<description>flat dim over the whole frame - bright fanart would swallow the flags and pills</description>
				<include>FullScreenDimensions</include>
				<texture colordiffuse="4DFFFFFF">colors/black.png</texture>
			</control>
			<control type="image">
				<description>left scrim: the gradient the title, plot and buttons sit on</description>
				<include>FullScreenDimensions</include>
				<texture>scrim_left.png</texture>
			</control>
			<control type="image">
				<description>bottom scrim: seats the pills and the cast row</description>
				<left>0</left>
				<bottom>0</bottom>
				<width>100%</width>
				<height>460</height>
				<texture colordiffuse="DD000000">overlays/overlayfade.png</texture>
			</control>
		</control>
		<control type="group">
			<centertop>50%</centertop>
			<height>1080</height>
			<centerleft>50%</centerleft>
			<width>1920</width>
			<include>OpenClose_Left</include>
			<animation effect="fade" start="100" end="0" time="200" tween="sine" condition="Window.IsVisible(script-embuary-video.xml) | Window.IsVisible(script-embuary-person.xml) | Window.IsVisible(script-embuary-image.xml)">Conditional</animation>
			<control type="image">
				<description>clearlogo, bottom aligned so short and tall logos share a baseline</description>
				<left>88</left>
				<top>60</top>
				<width>620</width>
				<height>190</height>
				<aspectratio align="left" aligny="bottom">keep</aspectratio>
				<fadetime>250</fadetime>
				<texture>$VAR[InfoDialogLogoVar]</texture>
				<visible>!String.IsEmpty(ListItem.Art(clearlogo)) | !String.IsEmpty(ListItem.Art(tvshow.clearlogo))</visible>
			</control>
			<control type="label">
				<description>title fallback when there is no clearlogo</description>
				<left>92</left>
				<top>60</top>
				<width>1180</width>
				<height>190</height>
				<aligny>bottom</aligny>
				<font>font52_title</font>
				<label>$VAR[InfoDialogTitleVar]</label>
				<scroll>true</scroll>
				<shadowcolor>text_shadow</shadowcolor>
				<visible>String.IsEmpty(ListItem.Art(clearlogo)) + String.IsEmpty(ListItem.Art(tvshow.clearlogo))</visible>
			</control>
			<control type="label">
				<description>episode number and title, or the movie tagline</description>
				<left>92</left>
				<top>274</top>
				<width>1180</width>
				<height>38</height>
				<font>font27_title</font>
				<textcolor>grey</textcolor>
				<label>$VAR[InfoDialogSubLabelVar]</label>
				<shadowcolor>text_shadow</shadowcolor>
			</control>
			<control type="label">
				<left>92</left>
				<top>336</top>
				<width>1400</width>
				<height>46</height>
				<aligny>center</aligny>
				<font>font27_title</font>
				<label>$VAR[InfoDialogMetaLabelVar]</label>
				<shadowcolor>text_shadow</shadowcolor>
			</control>
			<control type="grouplist" id="5200">
				<description>everything under the meta line flows, so a short plot pulls the rest up</description>
				<left>88</left>
				<top>400</top>
				<width>1200</width>
				<height>520</height>
				<orientation>vertical</orientation>
				<align>left</align>
				<itemgap>24</itemgap>
				<onup>noop</onup>
				<ondown>5100</ondown>
				<onleft>noop</onleft>
				<onright>noop</onright>
				<control type="textbox">
					<description>plot: sized to its own text, capped at four lines. The cap plus the rows
					     under it has to stay inside this container's height, or the grouplist scrolls and
					     clips them. The icon row has a button for the full text</description>
					<width>884</width>
					<height max="144">auto</height>
					<font>font27</font>
					<label fallback="19055">$INFO[ListItem.Plot]</label>
					<shadowcolor>text_shadow</shadowcolor>
					<autoscroll delay="10000" time="5000" repeat="10000">Skin.HasSetting(AutoScroll)</autoscroll>
				</control>
				<control type="label">
					<description>the first names out of the cast container, the rest are in the cast row</description>
					<width>1180</width>
					<height>56</height>
					<aligny>center</aligny>
					<font>font27</font>
					<textcolor>grey</textcolor>
					<label>$LOCALIZE[206]: $INFO[Container(50).ListItemAbsolute(0).Label]$INFO[Container(50).ListItemAbsolute(1).Label,   [COLOR 33FFFFFF]•[/COLOR]   ]$INFO[Container(50).ListItemAbsolute(2).Label,   [COLOR 33FFFFFF]•[/COLOR]   ]</label>
					<shadowcolor>text_shadow</shadowcolor>
					<visible>Integer.IsGreater(Container(50).NumItems,0) + !String.IsEqual(ListItem.DBType,set)</visible>
				</control>
				<include content="InfoPill">
					<param name="id" value="8"/>
					<param name="icon" value="icons/infodialogs/play.png"/>
					<param name="label" value="$VAR[VideoInfoPlayButtonLabelVar]"/>
				</include>
				<include content="InfoPill">
					<param name="id" value="11"/>
					<param name="icon" value="icons/infodialogs/trailer.png"/>
					<param name="label" value="$LOCALIZE[20410]"/>
					<param name="visible" value="!String.IsEmpty(ListItem.Trailer) + ![String.StartsWith(Container.FolderPath,plugin://) + String.Contains(Container.FolderPath,trailer)]"/>
				</include>
				<include content="InfoPill">
					<param name="id" value="4401"/>
					<param name="icon" value="icons/infodialogs/similar.png"/>
					<param name="label" value="$LOCALIZE[31722]"/>
					<param name="onclick_1" value="Dialog.Close(all,true)"/>
					<param name="onclick_2_condition" value="String.IsEqual(ListItem.DBType,movie)"/>
					<param name="onclick_2" value="ActivateWindow(Videos,plugin://plugin.video.themoviedb.helper/?info=recommendations&amp;tmdb_type=movie&amp;tmdb_id=$INFO[ListItem.UniqueID(tmdb)],return)"/>
					<param name="onclick_3_condition" value="String.IsEqual(ListItem.DBType,tvshow)"/>
					<param name="onclick_3" value="ActivateWindow(Videos,plugin://plugin.video.themoviedb.helper/?info=recommendations&amp;tmdb_type=tv&amp;tmdb_id=$INFO[ListItem.UniqueID(tmdb)],return)"/>
					<param name="visible" value="System.AddonIsEnabled(plugin.video.themoviedb.helper) + !String.IsEmpty(ListItem.UniqueID(tmdb)) + [String.IsEqual(ListItem.DBType,movie) | String.IsEqual(ListItem.DBType,tvshow)]"/>
				</include>
			</control>
			<control type="grouplist" id="5100">
				<left>88</left>
				<top>940</top>
				<onup>5200</onup>
				<description>secondary actions - icon only, the focused one is named by the hint beside the
				     row. Hidden unless the extended options setting is on</description>
				<visible>Skin.HasSetting(info_extended_options)</visible>
				<width>1400</width>
				<height>64</height>
				<orientation>horizontal</orientation>
				<align>left</align>
				<itemgap>12</itemgap>
				<ondown>noop</ondown>
				<onleft>noop</onleft>
				<onright>noop</onright>
				<include content="InfoIconButton">
					<param name="id" value="4400"/>
					<param name="icon" value="icons/infodialogs/director.png"/>
					<param name="onclick_1" value="SetFocus(50)"/>
					<param name="visible" value="Integer.IsGreater(Container(50).NumItems,0)"/>
				</include>
				<include content="InfoIconButton">
					<param name="id" value="138"/>
					<param name="icon" value="icons/infodialogs/info.png"/>
					<param name="onclick_1" value="SetProperty(TextViewer_Header,$LOCALIZE[207],home)"/>
					<param name="onclick_2" value="SetProperty(TextViewer_Text,$ESCINFO[ListItem.Plot],home)"/>
					<param name="onclick_3" value="ActivateWindow(1102)"/>
					<param name="visible" value="!String.IsEmpty(ListItem.Plot)"/>
				</include>
				<include content="InfoIconButton">
					<param name="id" value="7"/>
					<param name="icon" value="icons/infodialogs/rating.png"/>
					<param name="enable" value="String.IsEmpty(Container.PluginName) + !String.IsEqual(ListItem.DBType,set)"/>
					<param name="visible" value="!String.IsEqual(ListItem.DBType,set)"/>
				</include>
				<include content="InfoIconButton">
					<param name="id" value="14"/>
					<param name="icon" value="icons/infodialogs/versions.png"/>
					<param name="visible" value="ListItem.HasVideoVersions"/>
				</include>
				<include content="InfoIconButton">
					<param name="id" value="15"/>
					<param name="icon" value="icons/infodialogs/extras.png"/>
					<param name="visible" value="ListItem.HasVideoExtras"/>
				</include>
				<include content="InfoIconButton">
					<param name="id" value="443"/>
					<param name="icon" value="icons/infodialogs/set.png"/>
					<param name="onclick_1" value="Dialog.Close(all,true)"/>
					<param name="onclick_2" value="ActivateWindow(Videos,videodb://movies/sets/$INFO[ListItem.SetId]/?setid=$INFO[ListItem.SetId])"/>
					<param name="visible" value="!String.IsEmpty(ListItem.SetID)"/>
				</include>
				<include content="InfoIconButton">
					<param name="id" value="13"/>
					<param name="icon" value="icons/infodialogs/cinema.png"/>
					<param name="visible" value="!String.IsEmpty(ListItem.Director)"/>
				</include>
				<include content="InfoIconButton">
					<param name="id" value="10"/>
					<param name="icon" value="icons/infodialogs/choose_image.png"/>
					<param name="visible" value="Control.IsEnabled(10)"/>
				</include>
				<include content="InfoIconButton">
					<param name="id" value="6"/>
					<param name="icon" value="icons/infodialogs/update.png"/>
					<param name="visible" value="Control.IsEnabled(6)"/>
				</include>
			</control>
			<control type="label">
				<description>names whatever is focused in the icon row</description>
				<visible>Skin.HasSetting(info_extended_options)</visible>
				<left>700</left>
				<top>940</top>
				<width>560</width>
				<height>64</height>
				<aligny>center</aligny>
				<font>font27</font>
				<textcolor>grey</textcolor>
				<label>$VAR[InfoDialogHintVar]</label>
				<shadowcolor>text_shadow</shadowcolor>
				<animation effect="fade" time="200">VisibleChange</animation>
			</control>
			<control type="grouplist">
				<description>stream badges, bottom right - empty for tvshow and season items, which carry no stream details</description>
				<visible>!Skin.HasSetting(hide_mediaflags)</visible>
				<right>88</right>
				<top>950</top>
				<width>900</width>
				<height>44</height>
				<orientation>horizontal</orientation>
				<align>right</align>
				<itemgap>10</itemgap>
				<include content="InfoBadge">
					<param name="label" value="$VAR[InfoDialogResolutionBadgeVar]"/>
					<param name="visible" value="!String.IsEmpty(ListItem.VideoResolution)"/>
				</include>
				<include content="InfoBadge">
					<param name="label" value="$VAR[InfoDialogHdrBadgeVar]"/>
					<param name="visible" value="!String.IsEmpty(ListItem.HdrType)"/>
				</include>
				<include content="InfoBadge">
					<param name="label" value="$VAR[InfoDialogVideoCodecBadgeVar]"/>
					<param name="visible" value="!String.IsEmpty(ListItem.VideoCodec)"/>
				</include>
				<include content="InfoBadge">
					<param name="label" value="$VAR[InfoDialogAudioCodecBadgeVar]"/>
					<param name="visible" value="!String.IsEmpty(ListItem.AudioCodec)"/>
				</include>
				<include content="InfoBadge">
					<param name="label" value="$VAR[InfoDialogAudioChannelsBadgeVar]"/>
					<param name="visible" value="!String.IsEmpty(ListItem.AudioChannels)"/>
				</include>
			</control>
			<control type="group">
				<description>cast row: only on screen while it or the pill that opens it is focused</description>
				<left>740</left>
				<top>580</top>
				<width>1140</width>
				<height>380</height>
				<visible>Control.HasFocus(50) | Control.HasFocus(4400)</visible>
				<animation effect="fade" time="200">VisibleChange</animation>
				<animation effect="slide" start="0,40" end="0,0" time="250" tween="sine" easing="out">Visible</animation>
				<control type="panel" id="50">
					<left>0</left>
					<top>0</top>
					<width>1140</width>
					<height>360</height>
					<orientation>horizontal</orientation>
					<scrolltime tween="sine" easing="out">200</scrolltime>
					<onup>5100</onup>
					<ondown>5100</ondown>
					<onleft>5100</onleft>
					<onright>50</onright>
					<itemlayout height="330" width="210" condition="!Container.Content(Sets)">
						<include content="InfoDialogCastCard">
							<param name="art" value="$INFO[ListItem.Thumb]"/>
							<param name="fallback" value="DefaultActorSolid.png"/>
						</include>
					</itemlayout>
					<focusedlayout height="330" width="210" condition="!Container.Content(Sets)">
						<include content="InfoDialogCastCard">
							<param name="art" value="$INFO[ListItem.Thumb]"/>
							<param name="fallback" value="DefaultActorSolid.png"/>
							<param name="focused" value="true"/>
						</include>
					</focusedlayout>
					<itemlayout height="330" width="210" condition="Container.Content(Sets)">
						<include content="InfoDialogCastCard">
							<param name="art" value="$INFO[ListItem.Art(poster)]"/>
							<param name="fallback" value="DefaultVideo.png"/>
						</include>
					</itemlayout>
					<focusedlayout height="330" width="210" condition="Container.Content(Sets)">
						<include content="InfoDialogCastCard">
							<param name="art" value="$INFO[ListItem.Art(poster)]"/>
							<param name="fallback" value="DefaultVideo.png"/>
							<param name="focused" value="true"/>
						</include>
					</focusedlayout>
				</control>
			</control>
			<include content="LeftRightArrows">
				<param name="list_id" value="50"/>
				<param name="left_posx" value="706"/>
				<param name="right_posx" value="1886"/>
				<param name="posy" value="716"/>
				<param name="visible" value="Control.HasFocus(50)"/>
			</include>
		</control>
	</controls>
</window>
