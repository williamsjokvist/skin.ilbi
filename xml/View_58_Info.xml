<?xml version="1.0" encoding="UTF-8"?>
<includes>
	<include name="View_58_Info">
		<control type="group">
			<description>the series information screen</description>
			<centertop>50%</centertop>
			<height>1080</height>
			<centerleft>50%</centerleft>
			<width>1920</width>
			<visible>Control.IsVisible(58)</visible>
			<animation effect="fade" time="200">VisibleChange</animation>
			<include>OpenClose_Left</include>
			<control type="list" id="5850">
				<description>the series' own record, looked up by title</description>
				<left>0</left>
				<top>0</top>
				<width>1</width>
				<height>1</height>
				<itemlayout width="1" height="1">
					<control type="image">
						<width>1</width>
						<height>1</height>
						<texture/>
					</control>
				</itemlayout>
				<focusedlayout width="1" height="1">
					<control type="image">
						<width>1</width>
						<height>1</height>
						<texture/>
					</control>
				</focusedlayout>
				<content limit="1">videodb://tvshows/titles/?xsp={"type":"tvshows","rules":{"and":[{"field":"title","operator":"is","value":"$INFO[Container.ShowTitle]"}]}}</content>
			</control>
			<control type="grouplist" id="5800">
				<description>series actions, over the plot they flow under. Each pill that swaps the view
				     also focuses it: Kodi moves focus onto a new view only when the outgoing view control
				     held it, and here a pill does, so the strip would arrive with nothing focused</description>
				<left>88</left>
				<top>400</top>
				<width>1200</width>
				<height>600</height>
				<orientation>vertical</orientation>
				<align>left</align>
				<itemgap>24</itemgap>
				<onup>9000</onup>
				<ondown>noop</ondown>
				<onleft>noop</onleft>
				<onright>noop</onright>
				<onback>ReplaceWindow(home)</onback>
				<onback>SetFocus(9000)</onback>
				<control type="textbox">
					<description>the series' plot, capped at four lines</description>
					<width>884</width>
					<height max="144">auto</height>
					<font>font27</font>
					<label fallback="19055">$VAR[TVShowScreenPlotVar]</label>
					<shadowcolor>text_shadow</shadowcolor>
					<autoscroll delay="10000" time="5000" repeat="10000">Skin.HasSetting(AutoScroll)</autoscroll>
				</control>
				<include content="InfoPill">
					<param name="id" value="5801"/>
					<param name="icon" value="icons/infodialogs/play.png"/>
					<param name="label" value="$LOCALIZE[208]"/>
					<param name="onclick_1" value="PlayMedia($INFO[Container.FolderPath],resume)"/>
				</include>
				<include content="InfoPill">
					<param name="id" value="5802"/>
					<param name="icon" value="icons/infodialogs/set.png"/>
					<param name="label" value="$LOCALIZE[31725]"/>
					<param name="onclick_1" value="Container.SetViewMode(56)"/>
					<param name="onclick_2" value="SetFocus(56)"/>
					<param name="visible" value="Container.Content(seasons)"/>
				</include>
				<include content="InfoPill">
					<param name="id" value="5803"/>
					<param name="icon" value="icons/infodialogs/set.png"/>
					<param name="label" value="$LOCALIZE[20360]"/>
					<param name="onclick_1" value="Container.SetViewMode(57)"/>
					<param name="onclick_2" value="SetFocus(57)"/>
					<param name="visible" value="$EXP[tvshow_flattened_episodes]"/>
				</include>
				<include content="InfoPill">
					<param name="id" value="5804"/>
					<param name="icon" value="icons/infodialogs/trailer.png"/>
					<param name="label" value="$LOCALIZE[20410]"/>
					<param name="onclick_1" value="PlayMedia($ESCINFO[Container(5850).ListItem.Trailer])"/>
					<param name="visible" value="!String.IsEmpty(Container(5850).ListItem.Trailer)"/>
				</include>
				<include content="InfoPill">
					<param name="id" value="5805"/>
					<param name="icon" value="icons/infodialogs/similar.png"/>
					<param name="label" value="$LOCALIZE[31722]"/>
					<param name="onclick_1" value="ActivateWindow(Videos,plugin://plugin.video.themoviedb.helper/?info=recommendations&amp;tmdb_type=tv&amp;tmdb_id=$INFO[Container(5850).ListItem.UniqueID(tmdb)],return)"/>
					<param name="visible" value="System.AddonIsEnabled(plugin.video.themoviedb.helper) + !String.IsEmpty(Container(5850).ListItem.UniqueID(tmdb))"/>
				</include>
			</control>
		</control>
		<control type="panel" id="58">
			<description>binds the view to the directory; the screen itself is drawn above</description>
			<left>-10</left>
			<top>-10</top>
			<width>1</width>
			<height>1</height>
			<onfocus>SetFocus(5800)</onfocus>
			<onback>ReplaceWindow(home)</onback>
			<onback>SetFocus(9000)</onback>
			<viewtype label="31703">icon</viewtype>
			<visible>Container.Content(seasons) | $EXP[tvshow_flattened_episodes]</visible>
			<itemlayout width="1" height="1">
				<control type="image">
					<width>1</width>
					<height>1</height>
					<texture/>
				</control>
			</itemlayout>
			<focusedlayout width="1" height="1">
				<control type="image">
					<width>1</width>
					<height>1</height>
					<texture/>
				</control>
			</focusedlayout>
		</control>
	</include>
</includes>
